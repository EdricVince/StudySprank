NODE_ENV=development

# APP
PORT=3000
CORS_ORIGINS=http://localhost:5173

# DATABASE
DB_TYPE=postgres
DB_HOST=your-db-host
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
# DB_SYNCHRONIZE=true is a local-only shortcut — production schema comes from src/migrations.
DB_SYNCHRONIZE=false
# Migrations run automatically on boot; set to false to run them manually (pnpm migration:run).
DB_MIGRATIONS_RUN=true
# Set to false only for a local Postgres without TLS (Supabase needs SSL).
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend base URL (used to build the password-reset link)
APP_URL=http://localhost:5173

# Email / SMTP for password-reset (Gmail example — use a Gmail App Password, not your login password)
# 1) Enable 2-Step Verification on the Gmail account
# 2) Google Account > Security > App passwords > generate one > paste as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail-address@gmail.com
